{
  "name": "jaiba-ui",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop:sidecar": "node ../../scripts/prepare-desktop-sidecar.mjs",
    "desktop:dev": "npm run desktop:sidecar && node ../../scripts/run-desktop.mjs dev",
    "desktop:build": "npm run desktop:sidecar -- release && node ../../scripts/run-desktop.mjs build",
    "desktop:run": "node ../../scripts/run-desktop.mjs run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@xyflow/react": "^12.11.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "esbuild": "^0.28.1",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
