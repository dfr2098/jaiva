# Stack release-core (Postgres + Jaiba + UI)
# Puertos host por defecto altos para no chocar con lab/Prometheus (9090) u otras UIs (9080).
POSTGRES_USER=jaiba
POSTGRES_PASSWORD=jaiba_stable
POSTGRES_DB=jaiba_stable
POSTGRES_PORT=15433

JAIBA_MASTER_KEY=jaiba-stable-master-key-change-me
JAIBA_ADMIN_TOKEN=jaiba-stable-admin-token
JAIBA_SERVER_ADDR=0.0.0.0:9090
JAIBA_API_PORT=19090

UI_PORT=19080
